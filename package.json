  "repository": {
    "type": "git",
    "url": "git+https://github.com/jotaodiceu/stripe2ofx.git"
  },
  "homepage": "https://github.com/jotaodiceu/stripe2ofx#readme",
  "keywords": [
    "stripe",
    "ofx",
    "csv",
    "accounting",
    "cli"
  ],
  "author": "Jota Odiceu",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/jotaodiceu/stripe2ofx/issues"
  },
  "type": "module",
  "main": "stripe2ofx.js",
  "bin": {
    "stripe2ofx": "stripe2ofx.js"
  },
  "files": [
    "stripe2ofx.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "csv-parse": "7.0.1",
    "moment": "2.30.1"
  }
}
